{
  "$defs": {
    "ArticleApproval": {
      "additionalProperties": false,
      "properties": {
        "approved_by": {
          "minLength": 1,
          "title": "Approved By",
          "type": "string"
        },
        "approved_at": {
          "format": "date-time",
          "title": "Approved At",
          "type": "string"
        },
        "content_sha256": {
          "minLength": 1,
          "title": "Content Sha256",
          "type": "string"
        }
      },
      "required": [
        "approved_by",
        "approved_at",
        "content_sha256"
      ],
      "title": "ArticleApproval",
      "type": "object"
    },
    "ArticleDocument": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "content": {
          "minLength": 1,
          "title": "Content",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/SourceDocument"
          },
          "title": "Sources",
          "type": "array"
        },
        "reviewed_at": {
          "format": "date",
          "title": "Reviewed At",
          "type": "string"
        },
        "status": {
          "enum": [
            "draft",
            "approved",
            "unverified",
            "rejected"
          ],
          "title": "Status",
          "type": "string"
        },
        "approval": {
          "anyOf": [
            {
              "$ref": "#/$defs/ArticleApproval"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        }
      },
      "required": [
        "id",
        "title",
        "content",
        "sources",
        "reviewed_at",
        "status"
      ],
      "title": "ArticleDocument",
      "type": "object"
    },
    "SourceDocument": {
      "additionalProperties": false,
      "properties": {
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "reference": {
          "minLength": 1,
          "title": "Reference",
          "type": "string"
        },
        "locator": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Locator"
        },
        "revision": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revision"
        }
      },
      "required": [
        "title",
        "reference"
      ],
      "title": "SourceDocument",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1",
      "title": "Schema Version",
      "type": "string"
    },
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "version": {
      "minLength": 1,
      "title": "Version",
      "type": "string"
    },
    "articles": {
      "items": {
        "$ref": "#/$defs/ArticleDocument"
      },
      "title": "Articles",
      "type": "array"
    }
  },
  "required": [
    "schema_version",
    "document_id",
    "version",
    "articles"
  ],
  "title": "KnowledgeDocument",
  "type": "object"
}
