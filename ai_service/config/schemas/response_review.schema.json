{
  "$defs": {
    "ApplicableAssessment": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Specific assessment of this check against actual user evidence and original draft text.",
          "minLength": 1,
          "title": "Reason",
          "type": "string",
          "x-provider-description": true
        },
        "field_paths": {
          "description": "Cite at least one exact original draft pointer for this always-applicable check.",
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Field Paths",
          "type": "array",
          "x-provider-description": true
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "field_paths",
        "passed"
      ],
      "title": "ApplicableAssessment",
      "type": "object"
    },
    "NamedAssessment": {
      "additionalProperties": false,
      "properties": {
        "reason": {
          "description": "Specific assessment of this check against actual user evidence and original draft text.",
          "minLength": 1,
          "title": "Reason",
          "type": "string",
          "x-provider-description": true
        },
        "field_paths": {
          "description": "Exact JSON pointers at the restored draft root; empty only when this check has no applicable field.",
          "items": {
            "type": "string"
          },
          "title": "Field Paths",
          "type": "array",
          "x-provider-description": true
        },
        "passed": {
          "title": "Passed",
          "type": "boolean"
        }
      },
      "required": [
        "reason",
        "field_paths",
        "passed"
      ],
      "title": "NamedAssessment",
      "type": "object"
    },
    "NamedReviewAssessments": {
      "additionalProperties": false,
      "properties": {
        "relevance": {
          "$ref": "#/$defs/ApplicableAssessment"
        },
        "completeness": {
          "$ref": "#/$defs/ApplicableAssessment"
        },
        "neutral_voice": {
          "$ref": "#/$defs/ApplicableAssessment"
        },
        "choice_equivalence": {
          "$ref": "#/$defs/NamedAssessment"
        },
        "grounding": {
          "$ref": "#/$defs/NamedAssessment"
        },
        "context": {
          "$ref": "#/$defs/NamedAssessment"
        },
        "followups": {
          "$ref": "#/$defs/NamedAssessment"
        }
      },
      "required": [
        "relevance",
        "completeness",
        "neutral_voice",
        "choice_equivalence",
        "grounding",
        "context",
        "followups"
      ],
      "title": "NamedReviewAssessments",
      "type": "object"
    },
    "ReviewIssue": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "semantic",
            "neutral_voice",
            "grounding",
            "context",
            "choice",
            "contract"
          ],
          "title": "Kind",
          "type": "string"
        },
        "field_path": {
          "description": "Exact JSON pointer relative to the restored draft root, for example /response or /questions/0/title. Do not prefix /draft.",
          "minLength": 1,
          "title": "Field Path",
          "type": "string",
          "x-provider-description": true
        },
        "quoted_text": {
          "description": "Exact unchanged substring of the original string at field_path, without surrounding quotation marks or paraphrase.",
          "minLength": 1,
          "title": "Quoted Text",
          "type": "string",
          "x-provider-description": true
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "field_path",
        "quoted_text",
        "reason"
      ],
      "title": "ReviewIssue",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "A single model assessment per check, rather than contradictory verdict copies.",
  "properties": {
    "assessments": {
      "$ref": "#/$defs/NamedReviewAssessments",
      "description": "One assessment for every required named property. Each property identifies its check; do not emit an array or repeated check entries.",
      "x-provider-description": true
    },
    "issues": {
      "items": {
        "$ref": "#/$defs/ReviewIssue"
      },
      "title": "Issues",
      "type": "array"
    },
    "reviewed_surface_groups": {
      "items": {
        "enum": [
          "response",
          "questions",
          "clarification",
          "items",
          "suggested_replies",
          "references",
          "search_sources"
        ],
        "type": "string"
      },
      "title": "Reviewed Surface Groups",
      "type": "array"
    }
  },
  "required": [
    "assessments",
    "issues",
    "reviewed_surface_groups"
  ],
  "title": "NativeResponseReview",
  "type": "object"
}
