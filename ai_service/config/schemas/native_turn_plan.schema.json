{
  "$defs": {
    "CatalogOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "none",
            "selection",
            "inspection",
            "comparison"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "CatalogOperation",
      "type": "object"
    },
    "ClarificationStage": {
      "additionalProperties": false,
      "properties": {
        "response_mode": {
          "const": "clarification",
          "title": "Response Mode",
          "type": "string"
        },
        "catalog_operation": {
          "$ref": "#/$defs/CatalogOperation"
        },
        "text": {
          "description": "Original assistant invitation to pending questions; never echo the user. Natural ungendered Thai.",
          "minLength": 1,
          "title": "Text",
          "type": "string",
          "x-provider-description": true
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/PlannedQuestion"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "response_mode",
        "catalog_operation",
        "text",
        "questions"
      ],
      "title": "ClarificationStage",
      "type": "object"
    },
    "ConversationStage": {
      "additionalProperties": false,
      "properties": {
        "response_mode": {
          "description": "conversation: nonfactual social greeting only. information: non-catalog general information only. Catalog price/detail requests require equipment evidence or clarification.",
          "enum": [
            "conversation",
            "information"
          ],
          "title": "Response Mode",
          "type": "string",
          "x-provider-description": true
        },
        "catalog_operation": {
          "$ref": "#/$defs/NoCatalogOperation"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/PlannedQuestion"
          },
          "maxItems": 0,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "response_mode",
        "catalog_operation",
        "text",
        "questions"
      ],
      "title": "ConversationStage",
      "type": "object"
    },
    "DocumentStage": {
      "additionalProperties": false,
      "properties": {
        "response_mode": {
          "const": "documents",
          "title": "Response Mode",
          "type": "string"
        },
        "catalog_operation": {
          "$ref": "#/$defs/NoCatalogOperation"
        },
        "text": {
          "const": "",
          "title": "Text",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/PlannedQuestion"
          },
          "maxItems": 0,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "response_mode",
        "catalog_operation",
        "text",
        "questions"
      ],
      "title": "DocumentStage",
      "type": "object"
    },
    "EvidenceCatalogOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "enum": [
            "selection",
            "inspection",
            "comparison"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "EvidenceCatalogOperation",
      "type": "object"
    },
    "EvidenceStage": {
      "additionalProperties": false,
      "properties": {
        "response_mode": {
          "enum": [
            "equipment",
            "catalog_overview"
          ],
          "title": "Response Mode",
          "type": "string"
        },
        "catalog_operation": {
          "$ref": "#/$defs/EvidenceCatalogOperation"
        },
        "text": {
          "const": "",
          "title": "Text",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/PlannedQuestion"
          },
          "maxItems": 0,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "response_mode",
        "catalog_operation",
        "text",
        "questions"
      ],
      "title": "EvidenceStage",
      "type": "object"
    },
    "NativeBudgetPeriod": {
      "additionalProperties": false,
      "properties": {
        "user_period": {
          "description": "Explicit user billing period; preserve meaning.",
          "minLength": 1,
          "title": "User Period",
          "type": "string",
          "x-provider-description": true
        },
        "catalog_unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Exact catalog unit equivalent to user_period, else null. No conversions/guesses.",
          "title": "Catalog Unit",
          "x-provider-description": true
        }
      },
      "required": [
        "user_period",
        "catalog_unit"
      ],
      "title": "NativeBudgetPeriod",
      "type": "object"
    },
    "NativeKnownFact": {
      "additionalProperties": false,
      "properties": {
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "number"
            }
          ],
          "description": "Established text or quantitative JSON number; no punctuation placeholders. Omit unknown facts.",
          "title": "Value",
          "x-provider-description": true
        },
        "source_message_ids": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Source Message Ids",
          "type": "array"
        }
      },
      "required": [
        "dimension",
        "value",
        "source_message_ids"
      ],
      "title": "NativeKnownFact",
      "type": "object"
    },
    "NativePlanningUnderstanding": {
      "additionalProperties": false,
      "properties": {
        "intent": {
          "description": "Communicative purpose, separate from whether clarification is needed.",
          "enum": [
            "bot_capabilities",
            "item_inquiry",
            "inventory_search",
            "comparison",
            "clarification_needed",
            "platform_faq",
            "general_greeting",
            "general_information"
          ],
          "title": "Intent",
          "type": "string"
        },
        "ambiguity_level": {
          "description": "Unresolved meaning; not an action threshold.",
          "maximum": 1,
          "minimum": 0,
          "title": "Ambiguity Level",
          "type": "number"
        },
        "confidence": {
          "description": "Uncalibrated model self-assessment.",
          "maximum": 1,
          "minimum": 0,
          "title": "Confidence",
          "type": "number"
        },
        "target_items": {
          "description": "Equipment actually requested or referred to; resolve only supported references.",
          "items": {
            "type": "string"
          },
          "title": "Target Items",
          "type": "array"
        },
        "categories": {
          "description": "Conceptual equipment categories, without a fixed catalog taxonomy.",
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "budget_max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "description": "Explicit maximum budget; null when absent or units cannot be interpreted.",
          "title": "Budget Max"
        },
        "budget_period": {
          "anyOf": [
            {
              "$ref": "#/$defs/NativeBudgetPeriod"
            },
            {
              "type": "null"
            }
          ],
          "description": "Resolve the explicit user billing period against the canonical catalog units. Null when the user established no period.",
          "x-provider-description": true
        },
        "intended_use": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Relevant user-stated workload, after corrections; null if unknown.",
          "title": "Intended Use"
        },
        "needs_external_search": {
          "description": "Whether technical facts need external verification; shop prices, stock and policies need their authoritative source.",
          "title": "Needs External Search",
          "type": "boolean"
        },
        "search_query": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "description": "Focused technical verification query, or null when unnecessary.",
          "title": "Search Query"
        },
        "user_goal": {
          "minLength": 1,
          "title": "User Goal",
          "type": "string"
        },
        "additional_goals": {
          "items": {
            "type": "string"
          },
          "title": "Additional Goals",
          "type": "array"
        },
        "request_scope": {
          "enum": [
            "broad",
            "specific",
            "not_applicable"
          ],
          "title": "Request Scope",
          "type": "string"
        },
        "known_facts": {
          "items": {
            "$ref": "#/$defs/NativeKnownFact"
          },
          "title": "Known Facts",
          "type": "array"
        },
        "user_constraints": {
          "items": {
            "$ref": "#/$defs/NativeKnownFact"
          },
          "title": "User Constraints",
          "type": "array"
        },
        "excluded_items": {
          "items": {
            "type": "string"
          },
          "title": "Excluded Items",
          "type": "array"
        },
        "topic_changed": {
          "title": "Topic Changed",
          "type": "boolean"
        },
        "clarification_declined": {
          "title": "Clarification Declined",
          "type": "boolean"
        },
        "reference_resolution": {
          "description": "Supported current referent, or absence of prior referent. Nonempty.",
          "minLength": 1,
          "title": "Reference Resolution",
          "type": "string",
          "x-provider-description": true
        },
        "decision_reason": {
          "description": "Nonempty evidenced reason to answer or ask material pending questions.",
          "minLength": 1,
          "title": "Decision Reason",
          "type": "string",
          "x-provider-description": true
        }
      },
      "required": [
        "intent",
        "ambiguity_level",
        "confidence",
        "target_items",
        "categories",
        "budget_max",
        "budget_period",
        "intended_use",
        "needs_external_search",
        "search_query",
        "user_goal",
        "additional_goals",
        "request_scope",
        "known_facts",
        "user_constraints",
        "excluded_items",
        "topic_changed",
        "clarification_declined",
        "reference_resolution",
        "decision_reason"
      ],
      "title": "NativePlanningUnderstanding",
      "type": "object"
    },
    "NoCatalogOperation": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "none",
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "kind"
      ],
      "title": "NoCatalogOperation",
      "type": "object"
    },
    "PlannedQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/QuestionChoice"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "unrestricted_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionChoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a budget question, a separate explicit no-ceiling choice; otherwise null. Included in the displayed choices.",
          "x-provider-description": true
        },
        "branches": {
          "description": "Adapt to one earlier question: cover each source choice ID with relevant title/choices. Empty if independent or for unknown typed answers.",
          "items": {
            "$ref": "#/$defs/QuestionBranch"
          },
          "maxItems": 4,
          "title": "Branches",
          "type": "array",
          "x-provider-description": true
        }
      },
      "required": [
        "id",
        "dimension",
        "title",
        "choices"
      ],
      "title": "PlannedQuestion",
      "type": "object"
    },
    "QuestionBranch": {
      "additionalProperties": false,
      "properties": {
        "source_question_id": {
          "minLength": 1,
          "title": "Source Question Id",
          "type": "string"
        },
        "source_option_id": {
          "minLength": 1,
          "title": "Source Option Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/QuestionChoice"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "unrestricted_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionChoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a budget question, a separate explicit no-ceiling choice; otherwise null. Included in the displayed choices.",
          "x-provider-description": true
        }
      },
      "required": [
        "source_question_id",
        "source_option_id",
        "title",
        "choices"
      ],
      "title": "QuestionBranch",
      "type": "object"
    },
    "QuestionChoice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "description": "Complete answer. Budget maximum: closed ceiling with billing period or explicitly unlimited; never a lower bound.",
          "minLength": 1,
          "title": "Label",
          "type": "string",
          "x-provider-description": true
        },
        "value": {
          "description": "Exact label meaning, including ceiling/absence of ceiling and billing period. Preserve distinctions between choices.",
          "minLength": 1,
          "title": "Value",
          "type": "string",
          "x-provider-description": true
        },
        "supporting_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Item Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "supporting_item_ids"
      ],
      "title": "QuestionChoice",
      "type": "object"
    },
    "TechnicalStage": {
      "additionalProperties": false,
      "properties": {
        "response_mode": {
          "const": "technical",
          "title": "Response Mode",
          "type": "string"
        },
        "catalog_operation": {
          "$ref": "#/$defs/CatalogOperation"
        },
        "text": {
          "const": "",
          "title": "Text",
          "type": "string"
        },
        "questions": {
          "items": {
            "$ref": "#/$defs/PlannedQuestion"
          },
          "maxItems": 0,
          "title": "Questions",
          "type": "array"
        }
      },
      "required": [
        "response_mode",
        "catalog_operation",
        "text",
        "questions"
      ],
      "title": "TechnicalStage",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Provider contract separates current-stage prose from evidence synthesis.",
  "properties": {
    "speaker_register": {
      "const": "informal_ungendered",
      "description": "Exact machine label. Use natural ungendered Thai in all assistant text.",
      "title": "Speaker Register",
      "type": "string",
      "x-provider-description": true
    },
    "stage": {
      "anyOf": [
        {
          "$ref": "#/$defs/ClarificationStage"
        },
        {
          "$ref": "#/$defs/EvidenceStage"
        },
        {
          "$ref": "#/$defs/TechnicalStage"
        },
        {
          "$ref": "#/$defs/DocumentStage"
        },
        {
          "$ref": "#/$defs/ConversationStage"
        }
      ],
      "description": "Pending unknowns: clarification. Ready catalog: equipment; external verification: technical. Unfiltered browsing: catalog_overview. App evidence: documents. Non-catalog reply: conversation/information.",
      "title": "Stage",
      "x-provider-description": true
    },
    "overview_available_only": {
      "title": "Overview Available Only",
      "type": "boolean"
    },
    "analysis": {
      "$ref": "#/$defs/NativePlanningUnderstanding"
    },
    "knowledge_ids": {
      "items": {
        "type": "string"
      },
      "title": "Knowledge Ids",
      "type": "array"
    },
    "unverified_topic_ids": {
      "items": {
        "type": "string"
      },
      "title": "Unverified Topic Ids",
      "type": "array"
    }
  },
  "required": [
    "speaker_register",
    "stage",
    "overview_available_only",
    "analysis",
    "knowledge_ids",
    "unverified_topic_ids"
  ],
  "title": "NativeTurnPlan",
  "type": "object"
}
