{
  "$defs": {
    "PlannedQuestion": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "dimension": {
          "minLength": 1,
          "title": "Dimension",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/QuestionChoice"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "unrestricted_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionChoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a budget question, a separate explicit no-ceiling choice; otherwise null. Included in the displayed choices.",
          "x-provider-description": true
        },
        "branches": {
          "description": "Adapt to one earlier question: cover each source choice ID with relevant title/choices. Empty if independent or for unknown typed answers.",
          "items": {
            "$ref": "#/$defs/QuestionBranch"
          },
          "maxItems": 4,
          "title": "Branches",
          "type": "array",
          "x-provider-description": true
        }
      },
      "required": [
        "id",
        "dimension",
        "title",
        "choices"
      ],
      "title": "PlannedQuestion",
      "type": "object"
    },
    "PriceRequirement": {
      "additionalProperties": false,
      "properties": {
        "maximum": {
          "minimum": 0,
          "title": "Maximum",
          "type": "number"
        },
        "user_unit": {
          "minLength": 1,
          "title": "User Unit",
          "type": "string"
        },
        "catalog_units": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Catalog Units",
          "type": "array"
        },
        "interpretation": {
          "minLength": 1,
          "title": "Interpretation",
          "type": "string"
        }
      },
      "required": [
        "maximum",
        "user_unit",
        "catalog_units",
        "interpretation"
      ],
      "title": "PriceRequirement",
      "type": "object"
    },
    "QuestionBranch": {
      "additionalProperties": false,
      "properties": {
        "source_question_id": {
          "minLength": 1,
          "title": "Source Question Id",
          "type": "string"
        },
        "source_option_id": {
          "minLength": 1,
          "title": "Source Option Id",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "choices": {
          "items": {
            "$ref": "#/$defs/QuestionChoice"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Choices",
          "type": "array"
        },
        "unrestricted_choice": {
          "anyOf": [
            {
              "$ref": "#/$defs/QuestionChoice"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "For a budget question, a separate explicit no-ceiling choice; otherwise null. Included in the displayed choices.",
          "x-provider-description": true
        }
      },
      "required": [
        "source_question_id",
        "source_option_id",
        "title",
        "choices"
      ],
      "title": "QuestionBranch",
      "type": "object"
    },
    "QuestionChoice": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "label": {
          "description": "Complete answer. Budget maximum: closed ceiling with billing period or explicitly unlimited; never a lower bound.",
          "minLength": 1,
          "title": "Label",
          "type": "string",
          "x-provider-description": true
        },
        "value": {
          "description": "Exact label meaning, including ceiling/absence of ceiling and billing period. Preserve distinctions between choices.",
          "minLength": 1,
          "title": "Value",
          "type": "string",
          "x-provider-description": true
        },
        "supporting_item_ids": {
          "items": {
            "type": "string"
          },
          "title": "Supporting Item Ids",
          "type": "array"
        }
      },
      "required": [
        "id",
        "label",
        "value",
        "supporting_item_ids"
      ],
      "title": "QuestionChoice",
      "type": "object"
    },
    "SelectedItem": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "reason": {
          "minLength": 1,
          "title": "Reason",
          "type": "string"
        },
        "evidence_fields": {
          "description": "An array of individual catalog field names used as evidence for this item. Put the field names directly in the array.",
          "items": {
            "enum": [
              "name",
              "category",
              "description",
              "price",
              "type",
              "status"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Evidence Fields",
          "type": "array",
          "x-provider-description": true
        }
      },
      "required": [
        "id",
        "reason",
        "evidence_fields"
      ],
      "title": "SelectedItem",
      "type": "object"
    },
    "SelectionPlan": {
      "additionalProperties": false,
      "properties": {
        "mode": {
          "enum": [
            "items",
            "categories",
            "no_matches"
          ],
          "title": "Mode",
          "type": "string"
        },
        "purpose": {
          "enum": [
            "recommendation",
            "inspection"
          ],
          "title": "Purpose",
          "type": "string"
        },
        "selected_items": {
          "items": {
            "$ref": "#/$defs/SelectedItem"
          },
          "title": "Selected Items",
          "type": "array"
        },
        "price_requirement": {
          "anyOf": [
            {
              "$ref": "#/$defs/PriceRequirement"
            },
            {
              "type": "null"
            }
          ]
        },
        "reasoning": {
          "minLength": 1,
          "title": "Reasoning",
          "type": "string"
        }
      },
      "required": [
        "mode",
        "purpose",
        "selected_items",
        "price_requirement",
        "reasoning"
      ],
      "title": "SelectionPlan",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "One replacement of generated surfaces; authoritative facts are projected separately.",
  "properties": {
    "speaker_register": {
      "const": "informal_ungendered",
      "default": "informal_ungendered",
      "description": "Return the exact machine label informal_ungendered, never a description or translation. Answer and suggested replies use natural Thai without gendered speaker pronouns or honorifics.",
      "title": "Speaker Register",
      "type": "string",
      "x-provider-description": true
    },
    "request_fit": {
      "description": "Resolve suitability before prose: meets_request only when selected equipment satisfies the user's requested kind, function and every established constraint; no_supported_match when no candidate does so; not_assessed for inspection, technical information or category browsing without a justified item selection. Category membership or an eligible price alone never establishes suitability; complementary equipment does not replace the requested device. This conclusion guides writing and is not an independent review.",
      "enum": [
        "meets_request",
        "no_supported_match",
        "not_assessed"
      ],
      "title": "Request Fit",
      "type": "string",
      "x-provider-description": true
    },
    "selection": {
      "anyOf": [
        {
          "$ref": "#/$defs/SelectionPlan"
        },
        {
          "type": "null"
        }
      ]
    },
    "text": {
      "description": "Lead with the request-fit conclusion in friendly nongendered Thai. For no_supported_match explicitly explain that the requested kind/function has no supported match within the preserved constraints; describe complementary or differently constrained options only as alternatives, never as satisfying the unmet request. Do not infer incompatibility from absent evidence. Render catalog names, prices, units and status through {{item:ID:FIELD}} references to supplied rows, never rewritten literal values. For product recommendations, follow the system's presentation instructions: each product has a standalone bold name followed by a Markdown field list. Keep the name and fields on separate lines, never combine them into an inline paragraph.",
      "minLength": 1,
      "title": "Text",
      "type": "string",
      "x-provider-description": true
    },
    "search_ids": {
      "items": {
        "type": "string"
      },
      "title": "Search Ids",
      "type": "array"
    },
    "suggested_replies": {
      "items": {
        "type": "string"
      },
      "title": "Suggested Replies",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/PlannedQuestion"
      },
      "maxItems": 3,
      "title": "Questions",
      "type": "array"
    }
  },
  "required": [
    "request_fit",
    "selection",
    "text",
    "search_ids",
    "suggested_replies",
    "questions"
  ],
  "title": "ReplyRepair",
  "type": "object"
}
