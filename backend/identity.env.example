# รวมกับ .env เดิม; ห้ามนำ secrets จริงเข้า Git
OPERATIONS_ENABLED=false
IDENTITY_ENCRYPTION_KEY=
IDENTITY_HMAC_KEY=
IDENTITY_CLEANUP_INTERVAL=15m
IDENTITY_OCR_MIN_CONFIDENCE=0.55
INTERNAL_SERVICE_KEY=
AI_SERVICE_URL=http://127.0.0.1:8001
# CPU inference อาจนานกว่าค่าเดิม 45s; ให้สัมพันธ์กับ AI/HTTP timeout
AI_SERVICE_TIMEOUT=100s
WRITE_TIMEOUT=120s
